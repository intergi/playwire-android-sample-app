<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.playwire_android_sample_app">

        <meta-data
            android:name="com.google.android.gms.ads.AD_MANAGER_APP"
            android:value="true"/>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6531503260671471~7633749100" />

        <activity
            android:name=".ad_types.AdTypesActivity"
            android:exported="true"
            android:theme="@style/Theme.playwire_android_sample_app"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ads.view.banner.BannerActivity"
            android:exported="true" />

        <activity android:name=".ads.fullscreen.interstitial.InterstitialActivity"
            android:exported="true" />

        <activity
            android:name=".ads.fullscreen.rewarded.RewardedActivity"
            android:exported="true" />

        <activity
            android:name=".ads.view.nativead.NativeAdActivity"
            android:exported="true" />

        <activity
            android:name=".ads.fullscreen.app_open.AppOpenAdActivity"
            android:exported="true" />
    </application>

</manifest>