<?xml version="1.0" encoding="utf-8"?>
<com.example.demo_java.ads.view.nativead.NativeView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="16dp"
    android:background="#FFFFFF"
    android:minHeight="50dp"
    android:paddingLeft="20dp"
    android:paddingTop="3dp"
    android:paddingRight="20dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/ad_app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/ad_app_icon"
        android:paddingHorizontal="5dp"
        android:paddingBottom="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ad_headline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#673AB7"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ad_app_icon"
        app:layout_constraintTop_toTopOf="@id/ad_app_icon"
        tools:text="Headline" />

    <TextView
        android:id="@+id/ad_advertiser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ad_app_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ad_app_icon"
        app:layout_constraintTop_toBottomOf="@id/ad_headline"
        tools:text="Advertiser" />

    <TextView
        android:id="@+id/ad_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ad_app_icon"
        tools:text="This is the ad body. It can be multiple lines." />

    <FrameLayout
        android:id="@+id/ad_media"
        android:layout_width="250dp"
        android:layout_height="175dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ad_body" />

    <Button
        android:id="@+id/ad_call_to_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ad_media"
        tools:text="Install" />

    <TextView
        android:id="@+id/ad_store"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="5dp"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/ad_call_to_action"
        app:layout_constraintEnd_toStartOf="@id/ad_call_to_action"
        app:layout_constraintTop_toTopOf="@id/ad_call_to_action"
        tools:text="Google Play" />

    <TextView
        android:id="@+id/ad_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="5dp"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/ad_call_to_action"
        app:layout_constraintEnd_toStartOf="@id/ad_store"
        app:layout_constraintTop_toTopOf="@id/ad_call_to_action"
        tools:text="$1.99" />

</com.example.demo_java.ads.view.nativead.NativeView>